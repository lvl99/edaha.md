{
  "name": "@lvl99dotcom/edaha.md",
  "version": "0.1.0",
  "description": "Static site generator using markdown.",
  "keywords": [
    "blog",
    "static-site-generator",
    "markdown",
    "nunjucks",
    "rss",
    "editor"
  ],
  "author": "Matt Scheurich <matt@lvl99.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvl99/edaha.md.git"
  },
  "homepage": "https://github.com/lvl99/edaha.md#readme",
  "bugs": "https://github.com/lvl99/edaha.md/issues",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "edaha": "./dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "theme",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "dev:editor": "vite",
    "site:build": "node src/cli/bin.ts build",
    "site:serve": "node scripts/serve-site.ts",
    "site:dev": "node scripts/dev-site.ts",
    "typecheck": "tsc -p .",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "hono": "^4.13.13",
    "markdown-it": "^15.0.3",
    "mime-types": "^3.0.2",
    "nunjucks": "^3.2.4",
    "turndown": "^7.2.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@material-symbols/svg-400": "0.48.1",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-details": "3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/markdown-it": "^14.1.2",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.1.1",
    "@types/nunjucks": "^3.2.6",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "lit": "^3.3.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.12"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0"
}
