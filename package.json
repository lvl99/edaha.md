{
  "name": "edaha.md",
  "private": true,
  "description": "The edaha.md workspace: the static site generator, its editor and embed plugins, and the edaha.md website.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvl99/edaha.md.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @lvl99dotcom/edaha.md build && pnpm -r --filter \"!@lvl99dotcom/edaha.md\" build",
    "editor": "edaha editor",
    "dev:editor": "vite --config packages/edaha-editor/vite.config.ts",
    "site:build": "edaha build",
    "site:serve": "node scripts/serve-site.ts",
    "site:dev": "node scripts/dev-site.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p .",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lvl99dotcom/edaha-editor": "workspace:^",
    "@lvl99dotcom/edaha-plugin-bandcamp": "workspace:^",
    "@lvl99dotcom/edaha-plugin-mermaidjs": "workspace:^",
    "@lvl99dotcom/edaha-plugin-youtube": "workspace:^",
    "@lvl99dotcom/edaha.md": "workspace:^",
    "@types/markdown-it": "^14.1.2",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.1.1",
    "@types/nunjucks": "^3.2.6",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "mime-types": "^3.0.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.12"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0"
}
