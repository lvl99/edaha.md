{
  "name": "@lvl99dotcom/edaha-plugin-bandcamp",
  "version": "0.1.0",
  "description": "Embed Bandcamp album and track players in edaha.md sites from their page URLs.",
  "keywords": [
    "edaha.md",
    "edaha-plugin",
    "embed",
    "bandcamp",
    "music"
  ],
  "author": "Matt Scheurich <matt@lvl99.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvl99/edaha.md.git",
    "directory": "packages/edaha-plugin-bandcamp"
  },
  "homepage": "https://github.com/lvl99/edaha.md#readme",
  "bugs": "https://github.com/lvl99/edaha.md/issues",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "node ../edaha/scripts/build-plugin.ts",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@lvl99dotcom/edaha.md": "workspace:^"
  },
  "devDependencies": {
    "@lvl99dotcom/edaha.md": "workspace:^"
  }
}
