<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ list.name }} | {{ site.name }}</title>
    <link>{{ list.url | absoluteUrl(site.url) }}</link>
    <description>{{ site.description }}</description>
    <language>en</language>
    <atom:link href="{{ list.feedUrl | absoluteUrl(site.url) }}" rel="self" type="application/rss+xml" />
    {% if list.articles.length %}
    <lastBuildDate>{{ list.articles[0].date | rfc822 }}</lastBuildDate>
    {% endif %}
    {% for article in list.articles %}
    <item>
      <title>{{ article.title }}</title>
      <link>{{ article.url | absoluteUrl(site.url) }}</link>
      <guid isPermaLink="true">{{ article.url | absoluteUrl(site.url) }}</guid>
      <pubDate>{{ article.date | rfc822 }}</pubDate>
      {% if article.author and article.author.email %}
      <author>{{ article.author.email }} ({{ article.author.name }})</author>
      {% endif %}
      {% for tag in article.tags %}
      <category>{{ tag.name }}</category>
      {% endfor %}
      <description>{{ article.excerptHtml | absoluteUrls(site.url) }}</description>
    </item>
    {% endfor %}
  </channel>
</rss>
