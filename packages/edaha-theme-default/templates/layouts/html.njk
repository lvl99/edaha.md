<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% block headTitle %}{{ site.name }}{% endblock %}</title>
    <meta name="description" content="{% block headDescription %}{{ site.description }}{% endblock %}" />

    {% if list %}
    {% for feed in list.feeds %}
    <link rel="alternate" type="{{ feed.type }}" title="{{ list.name }} | {{ site.name }}" href="{{ feed.url }}" />
    {% endfor %}
    {% endif %}
    {% for alternate in (article.alternates if isArticle else list.alternates) %}
    <link rel="alternate" type="{{ alternate.type }}" href="{{ alternate.url }}" />
    {% endfor %}

    {% block headImports %}
      <link rel="stylesheet" href="{{ site.baseUrl }}/base.css" />
    {% endblock %}
    {% embedHead %}
  </head>
  <body class="{% if type %}{{ type }} {% endif %}{% block bodyClass %}{% endblock %}">
    {% block header %}
      <header class="site-header">
        <h1 class="site-title">
          <a href="{{ site.url }}">{{ site.name }}<span class="leaf-device"></span></a>
        </h1>
      </header>
      {% block headerNav %}{% endblock %}
    {% endblock %}

    {% block content %}
      <div class="site-content">
        <main class="site-main">
          {% block breadcrumb %}
            <nav class="site-breadcrumb" aria-label="Breadcrumb">
              <ul>
                <li><a href="{{ site.path }}">{{ site.name }}</a></li>
                {% block breadcrumbItems %}{% endblock %}
              </ul>
            </nav>
          {% endblock %}

          {% block main %}{% endblock %}
        </main>

        {% block aside %}{% endblock %}
      </div>
    {% endblock %}

    {% block footer %}
      <footer class="site-footer">
        {% block footerNav %}
          <nav aria-label="Sections">
            {% for name, type in site.types %}
              {% if type.generate.list %}
                <a href="{{ type.url }}">{{ type.labelPlural }}</a>
              {% endif %}
            {% endfor %}
          </nav>
        {% endblock %}

        {% block colophon %}
          <p class="colophon">
            <a href="{{ site.url }}">{{ site.name }}</a>
            &middot;
            Built with <a href="https://edaha.md" target="_blank" rel="noopener noreferrer">edaha.md</a>
          </p>
        {% endblock %}
      </footer>
    {% endblock %}

    {% block bodyImports %}{% endblock %}
    {% embedFoot %}
  </body>
</html>
