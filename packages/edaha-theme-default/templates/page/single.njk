{% extends "layouts/html.njk" %}

{% block headTitle %}{{ article.title }} | {{ site.name }}{% endblock %}

{% block headDescription %}{{ article.excerptText }}{% endblock %}

{% block breadcrumbItems %}
<li><a href="{{ article.url }}" aria-current="page">{{ article.title }}</a></li>
{% endblock %}

{% block main %}
<article>
  <h1 class="article-title">{{ article.title }}</h1>
  <p class="article-updated">Last updated: <time datetime="{{ article.date }}">{{ article.date | date }}</time></p>

  {{ article.bodyHtml | safe }}
</article>
{% endblock %}
