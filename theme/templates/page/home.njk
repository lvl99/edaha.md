{# The website's front page: its title and body, without the header or breadcrumbs #}
{% extends "layouts/html.njk" %}

{% block headTitle %}{{ site.name }} | {{ article.title }}{% endblock %}

{% block headDescription %}{{ site.description }}{% endblock %}

{% block bodyClass %}home{% endblock %}

{% block breadcrumb %}{% endblock %}

{% block main %}
<div class="home-body">
  {{ article.bodyHtml | safe }}
</div>
{% endblock %}
