{% extends "layouts/html.njk" %}

{% block head_title %}{{ article.title }} | {{ site.name }}{% endblock %}

{% block head_description %}{{ article.excerptText }}{% endblock %}

{% block breadcrumbItems %}
{% set typeSettings = site.types[article.type] %}
{% if typeSettings.generate.list %}
<li><a href="{{ typeSettings.url }}">{{ typeSettings.labelPlural }}</a></li>
{% endif %}
<li><a href="{{ article.url }}" aria-current="page">{{ article.title }}</a></li>
{% endblock %}

{% block main %}
<article>
  <h1 class="article-title">{{ article.title }}</h1>

  <div class="article-body">
    {{ article.bodyHtml | safe }}
  </div>

  {% if article.attachments.length %}
  <h2>Attachments</h2>
  <ul class="article-attachments">
    {% for attachment in article.attachments %}
    <li>
      <a href="{{ attachment.url }}">
        {% if attachment.thumbnail %}<img src="{{ attachment.thumbnail }}" alt="" />{% endif %}
        {{ attachment.name }}
      </a>
      ({{ attachment.mimeType }}{% if attachment.sizeRelative %}, {{ attachment.sizeRelative }}{% endif %})
    </li>
    {% endfor %}
  </ul>
  {% endif %}
</article>
{% endblock %}

{% block aside %}
<aside>
  <dl>
    <dt>Author</dt>
    <dd>
      {{ article.author.name }}
      {% if article.author.url %}(<a href="{{ article.author.url }}" rel="author">website</a>){% endif %}
    </dd>
    <dt>Date</dt>
    <dd><time datetime="{{ article.date }}">{{ article.date | date }}</time></dd>
    {% if article.tags.length %}
    <dt>Tagged</dt>
    <dd>
      {% for tag in article.tags %}{% if site.types[article.type].generate.tag %}<a href="{{ tag.url }}">{{ tag.name }}</a>{% else %}{{ tag.name }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}
    </dd>
    {% endif %}
  </dl>
</aside>
{% endblock %}
